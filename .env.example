# EasyReceipt environment variables (example only — never commit real values).
#
# DATABASE_URL is the PostgreSQL connection string. It is read on the server only
# (Prisma, the start script and API routes). Never expose it with a NEXT_PUBLIC_ prefix.
#
# On Render: set DATABASE_URL on the web service to the database's *Internal* URL.
# There is no local database for this project, so you normally do not need a local .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
